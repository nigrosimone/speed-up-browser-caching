# Fine riga deterministiche: il repo contiene sempre LF, a prescindere dal
# core.autocrlf della macchina. Coerente con quanto scriveva release-plugin.ps1.
* text=auto eol=lf

*.php  text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

*.jpg binary
*.png binary
*.gif binary
*.mo  binary

# ATTENZIONE: htaccess.txt e' storicamente in CRLF su SVN (nessun svn:eol-style,
# quindi wordpress.org ne serve i byte grezzi) ed e' cosi' da sempre nel pacchetto
# scaricato dagli utenti. "-text" disattiva ogni normalizzazione: il passaggio a git
# non deve cambiare nemmeno un byte di cio' che viene pubblicato.
# Questa riga sta dopo le regole generali perche' in .gitattributes vince l'ultima.
htaccess.txt -text

# File di sviluppo esclusi dagli archivi generati da GitHub ("Download ZIP").
# Nota: cio' che viene pubblicato su wordpress.org e' governato da .distignore.
/.github        export-ignore
/tests          export-ignore
/bin            export-ignore
/.wordpress-org export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.distignore     export-ignore
phpcs.xml.dist  export-ignore
phpunit.xml.dist export-ignore
composer.json   export-ignore
composer.lock   export-ignore
