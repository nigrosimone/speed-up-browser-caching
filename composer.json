{
    "name": "nigrosimone/speed-up-browser-caching",
    "description": "Help browser to cache a local copy of static files and improve page load times.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://wordpress.org/plugins/speed-up-browser-caching/",
    "authors": [
        {
            "name": "Simone Nigro",
            "email": "nigro.simone@gmail.com",
            "homepage": "https://profiles.wordpress.org/nigrosimone"
        }
    ],
    "require": {
        "php": ">=7.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "@php bin/install-hooks.php",
        "post-update-cmd": "@php bin/install-hooks.php",
        "install-hooks": "@php bin/install-hooks.php",
        "lint": "@php bin/lint.php",
        "check-version": "@php bin/check-version.php",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 7.0- --extensions=php --ignore=vendor,node_modules,tests .",
        "test": "phpunit"
    }
}
